# Konfiguracja produkcyjna — skopiuj do deploy/.env na serwerze (chmod 600). Plik .env nigdy nie trafia do gita.

# Domena showroomu (rekord A/AAAA na adres serwera). Bez własnej domeny na próbę: <ip-z-myślnikami>.sslip.io
SHOWROOM_DOMAIN=

# Wersja obrazów z GHCR: latest albo konkretny commit (sha-<7 znaków>) — do wycofania wdrożenia
IMAGE_TAG=latest

# Sekrety — generuj: openssl rand -base64 48
POSTGRES_PASSWORD=
SHOWROOM_JWT_SECRET=

# Pierwsze konto administratora (tworzone tylko, gdy w bazie nie ma żadnego konta). Hasło 12–128 znaków.
# Po pierwszym logowaniu można usunąć te wartości z pliku.
SHOWROOM_ADMIN_EMAIL=
SHOWROOM_ADMIN_PASSWORD=

# Dane marki w stopce zestawień PDF
# wartości ze spacjami lub apostrofem w cudzysłowie (plik czyta też bash w backup.sh)
SHOWROOM_BRAND_NAME="Fabian's Style"
SHOWROOM_BRAND_LEGAL_NAME=
SHOWROOM_BRAND_WEBSITE=
SHOWROOM_BRAND_EMAIL=
SHOWROOM_BRAND_PHONE=

# E-maile transakcyjne kont kupców (D23) — dostawca SMTP (np. Brevo, Postmark, Amazon SES), port 587 + STARTTLS.
# Domena nadawcy musi mieć SPF i DKIM, inaczej wiadomości trafią do spamu.
SHOWROOM_MAIL_FROM="Fabian's Style B2B <b2b@twoja-domena.pl>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Kopie zapasowe (deploy/backup.sh): katalog docelowy i liczba dni przechowywania
BACKUP_DIR=/var/backups/showroom
BACKUP_RETENTION_DAYS=14
