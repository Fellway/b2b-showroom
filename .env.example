# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Wygeneruj: openssl rand -base64 48
SHOWROOM_JWT_SECRET=

# Pierwsze konto administratora (tworzone tylko, gdy w bazie nie ma żadnego). Hasło: 12–128 znaków.
SHOWROOM_ADMIN_EMAIL=
SHOWROOM_ADMIN_PASSWORD=

# Lokalnie po HTTP (bez TLS) ciasteczko refresh nie może mieć flagi Secure
SHOWROOM_REFRESH_COOKIE_SECURE=false

# Opcjonalnie — domyślnie baza z docker-compose.yml
# DB_URL=jdbc:postgresql://localhost:5433/showroom
# DB_USERNAME=showroom
# DB_PASSWORD=showroom-dev
